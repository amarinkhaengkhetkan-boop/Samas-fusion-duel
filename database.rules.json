{
  "rules": {
    "rooms": {
      "$code": {
        ".write": "auth != null && data.child('info/host').val() === auth.uid",
        "info": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() ? newData.child('host').val() === auth.uid : data.child('host').val() === auth.uid)"
        },
        "secret": {
          ".read": false,
          ".write": "auth != null && root.child('rooms/' + $code + '/info/host').val() === auth.uid"
        },
        "members": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && newData.val() === root.child('rooms/' + $code + '/secret/pwHash').val()"
          }
        },
        "names": {
          ".read": "auth != null && root.child('rooms/' + $code + '/members/' + auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms/' + $code + '/members/' + auth.uid).exists()",
            ".validate": "newData.isString() && newData.val().length < 60"
          }
        },
        "seats": {
          ".read": "auth != null && root.child('rooms/' + $code + '/members/' + auth.uid).exists()",
          "$team": {
            ".write": "auth != null && root.child('rooms/' + $code + '/members/' + auth.uid).exists() && ($team === 'A' || $team === 'B') && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))"
          }
        },
        "ready": {
          ".read": "auth != null && root.child('rooms/' + $code + '/members/' + auth.uid).exists()",
          "$team": {
            ".write": "auth != null && root.child('rooms/' + $code + '/seats/' + $team).val() === auth.uid",
            ".validate": "newData.isBoolean()"
          }
        },
        "public": {
          ".read": "auth != null && root.child('rooms/' + $code + '/members/' + auth.uid).exists()"
        },
        "private": {
          "$team": {
            ".read": "auth != null && root.child('rooms/' + $code + '/seats/' + $team).val() === auth.uid"
          }
        },
        "actions": {
          ".read": "auth != null && root.child('rooms/' + $code + '/info/host').val() === auth.uid",
          "$id": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid && root.child('rooms/' + $code + '/seats/' + newData.child('team').val()).val() === auth.uid"
          }
        }
      }
    }
  }
}
