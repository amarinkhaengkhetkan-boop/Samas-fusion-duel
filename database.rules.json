{
  "rules": {
    "rooms": {
      "$code": {
        ".write": "auth != null && data.child('info/host').val() === auth.uid",
        "info": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() ? newData.child('host').val() === auth.uid : data.child('host').val() === auth.uid)"
        },
        "secret": {
          ".read": false,
          ".write": "auth != null && root.child('rooms/' + $code + '/info/host').val() === auth.uid"
        },
        "members": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && newData.val() === root.child('rooms/' + $code + '/secret/pwHash').val()"
          }
        },
        "names": {
          ".read": "auth != null && root.child('rooms/' + $code + '/members/' + auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms/' + $code + '/members/' + auth.uid).exists()",
            ".validate": "newData.isString() && newData.val().length < 60"
          }
        },
        "teams": {
          ".read": "auth != null && root.child('rooms/' + $code + '/members/' + auth.uid).exists()",
          "$team": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('rooms/' + $code + '/members/' + auth.uid).exists() && (($team === 'A' && !root.child('rooms/' + $code + '/teams/B/' + auth.uid).exists()) || ($team === 'B' && !root.child('rooms/' + $code + '/teams/A/' + auth.uid).exists()))",
              ".validate": "newData.isNumber()"
            }
          }
        },
        "ready": {
          ".read": "auth != null && root.child('rooms/' + $code + '/members/' + auth.uid).exists()",
          "$team": {
            ".write": "auth != null && root.child('rooms/' + $code + '/teams/' + $team + '/' + auth.uid).exists()",
            ".validate": "newData.isBoolean()"
          }
        },
        "public": {
          ".read": "auth != null && root.child('rooms/' + $code + '/members/' + auth.uid).exists()"
        },
        "private": {
          "$team": {
            ".read": "auth != null && root.child('rooms/' + $code + '/teams/' + $team + '/' + auth.uid).exists()"
          }
        },
        "actions": {
          ".read": "auth != null && root.child('rooms/' + $code + '/info/host').val() === auth.uid",
          "$id": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid && root.child('rooms/' + $code + '/teams/' + newData.child('team').val() + '/' + auth.uid).exists()"
          }
        },
        "log": {
          ".read": "auth != null && root.child('rooms/' + $code + '/info/host').val() === auth.uid"
        }
      }
    }
  }
}
